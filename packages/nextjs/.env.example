# Template for NextJS environment variables.

# For local development, copy this file, rename it to .env.local, and fill in the values.
# When deploying live, you'll need to store the vars in Vercel/System config.

# If not set, we provide default values (check `scaffold.config.ts`) so developers can start prototyping out of the box,
# but we recommend getting your own API Keys for Production Apps.

# To access the values stored in this env file you can use: process.env.VARIABLENAME
# You'll need to prefix the variables names with NEXT_PUBLIC_ if you want to access them on the client side.
# More info: https://nextjs.org/docs/pages/building-your-application/configuring/environment-variables
NEXT_PUBLIC_ALCHEMY_API_KEY=
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=


# OmniAgent X
# Worker URL (packages/agent-worker). The PWA calls it for operator consent and plan execution.
NEXT_PUBLIC_WORKER_URL=http://localhost:8787
# Server-only (used by app/api/strategy and app/api/guardian). Any OpenAI-compatible provider; DeepSeek in the MVP.
# Never prefix these with NEXT_PUBLIC_: the key must not reach the browser.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# Optional: a stronger model for the planning step only (e.g. deepseek-v4-pro). Defaults to LLM_MODEL.
LLM_PLANNER_MODEL=
# Optional: max output tokens per call (default 2048).
LLM_MAX_TOKENS=
# Hard cap on planning requests per server process per UTC day (each request = 2 paid LLM calls).
LLM_MAX_PLANS_PER_DAY=50
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz
# Optional client-side RPC override (e.g. QuickNode). Defaults to viem monadTestnet public RPC.
NEXT_PUBLIC_MONAD_TESTNET_RPC=
# Phase 3 dashboard
# Perpl public market-data WebSocket (defaults to wss://testnet.perpl.xyz/ws/v1/market-data)
NEXT_PUBLIC_PERPL_WS_URL=
# Server-side Perpl REST base for /api/perpl/context (defaults to https://testnet.perpl.xyz/api)
PERPL_API_URL=
# Envio indexer GraphQL endpoint (optional), e.g. http://localhost:8080/v1/graphql
NEXT_PUBLIC_INDEXER_URL=
# /api/strategy auth: the worker's operator address (GET <worker>/health → operator). When set, only
# accounts operated by this worker may request plans.
WORKER_OPERATOR_ADDRESS=
# Per-owner daily cap on planning requests (each = 2 paid LLM calls); LLM_MAX_PLANS_PER_DAY stays the global cap.
LLM_MAX_PLANS_PER_OWNER_PER_DAY=10
# Guardian compiler quotas (each compile = 1 LLM call).
LLM_MAX_MANDATES_PER_OWNER_PER_DAY=20
LLM_MAX_MANDATES_PER_DAY=200
# Show the scaffold's wallet button and debug page (developer tools). Mera is the account layer.
NEXT_PUBLIC_SHOW_WALLET_CONNECT=false
# Public https origin of this PWA (ERC-8004 agent card). Defaults to the request origin.
NEXT_PUBLIC_APP_URL=
# ERC-8004 agentId printed by `yarn workspace @omniagent/worker register-8004 --send`. Empty hides feedback.
NEXT_PUBLIC_GUARDIAN_AGENT_ID=
