# Operator hot key (EOA). It can trade but cannot withdraw (Perpl DelegatedAccount). Use a fresh testnet key.
OPERATOR_PK=
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz
PORT=8787
# Comma-separated origins allowed to call the worker (the PWA).
ALLOWED_ORIGINS=http://localhost:3000
# false = dry-run: validate and build orders, never send them. Set true only after S2 passes.
EXECUTION_ENABLED=false
SLIPPAGE_BPS=50
DATA_DIR=./data
# POST requests per minute per client IP (0 disables).
RATE_LIMIT_PER_MIN=20
# true behind a reverse proxy (Railway, Fly, …) so the client IP comes from X-Forwarded-For.
TRUST_PROXY=false
# Optional Envio GraphQL URL: fallback to learn a position's side when this worker did not open it.
INDEXER_URL=
