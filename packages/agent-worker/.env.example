# Operator hot key (EOA). It can trade but cannot withdraw (Perpl DelegatedAccount). Use a fresh testnet key.
OPERATOR_PK=
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz
PORT=8787
# Comma-separated origins allowed to call the worker (the PWA).
ALLOWED_ORIGINS=http://localhost:3000
# false = dry-run: validate and build orders, never send them. Set true only after S2 passes.
EXECUTION_ENABLED=false
SLIPPAGE_BPS=50
DATA_DIR=./data
