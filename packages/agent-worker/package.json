{
  "name": "@omniagent/worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/main.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "start:prod": "node dist/main.mjs"
  },
  "dependencies": {
    "@omniagent/core": "workspace:*",
    "tsx": "^4.20.3",
    "viem": "2.31.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "0.28.2",
    "typescript": "5.8.2",
    "vitest": "^3.2.4"
  }
}
